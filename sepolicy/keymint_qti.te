# QTI KeyMint AIDL service in recovery.
# Justification: dmesg denials — recovery exec's
# /vendor/bin/hw/android.hardware.security.keymint-service-qti which then
# opens /dev/qseecom and the QSEE dmabuf heaps.
# Transition pattern mirrors stock vendor_sepolicy.cil:6971-6976.

allow recovery vendor_hal_keymint_qti:process transition;
type_transition recovery vendor_hal_keymint_qti_exec:process vendor_hal_keymint_qti;
# recovery is coredomain: neverallow forbids its vendor_exec execute grant;
# entrypoint + transition scaffold kept (permissive today).
allow vendor_hal_keymint_qti vendor_hal_keymint_qti_exec:file { read getattr map execute open entrypoint };

# KeyMint TEE access  (stock:6981-6982)
allow vendor_hal_keymint_qti tee_device:chr_file { ioctl read write getattr open };
allow vendor_hal_keymint_qti vendor_dmabuf_qseecom_heap_device:chr_file { ioctl read getattr open };
allow vendor_hal_keymint_qti vendor_dmabuf_qseecom_ta_heap_device:chr_file { ioctl read getattr open };
allow vendor_hal_keymint_qti vendor_sp_keymaster_device:chr_file { ioctl read write getattr open };
